generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== CÁC BẢNG CHUNG =====

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Product {
  id         String      @id @default(uuid())
  name       String
  price      Int
  imageUrl   String?
  soldCount  Int         @default(0)
  orderItems OrderItem[]
  toppings   Topping[]
  recipes    Recipe[]    // Từ phần của bạn (BOM)
}

model Ingredient {
  id        String   @id @default(uuid())
  name      String
  stock     Float
  unit      String   @default("gram")
  recipes   Recipe[]
}

model Recipe {
  id           String     @id @default(uuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  amount       Float
}

model Topping {
  id                String             @id @default(uuid())
  name              String
  price             Int                @default(0)
  productId         String?
  product           Product?           @relation(fields: [productId], references: [id])
  orderItemToppings OrderItemTopping[]
}

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  passwordHash  String
  loyaltyPoints Int     @default(0)
  role          String  @default("CUSTOMER") // CUSTOMER, BARISTA, ADMIN
  tokenVersion  Int     @default(0) // Từ phần của main (Auth)
  orders        Order[]
  loyaltyTransactions LoyaltyTransaction[] // Từ phần của main
}

model Order {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  status      OrderStatus  @default(PENDING)
  total       Int
  createdAt   DateTime     @default(now())
  items       OrderItem[]
  payments    Payment[]    // Từ phần của main (Payment)
  promotionId String?      // Từ phần của main (Promotion)
  promotion   Promotion?   @relation(fields: [promotionId], references: [id])
}

model OrderItem {
  id        String             @id @default(uuid())
  orderId   String
  order     Order              @relation(fields: [orderId], references: [id])
  productId String
  product   Product            @relation(fields: [productId], references: [id])
  size      String
  qty       Int
  unitPrice Int
  lineTotal Int
  toppings  OrderItemTopping[]
}

model OrderItemTopping {
  id          String    @id @default(uuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  toppingId   String
  topping     Topping   @relation(fields: [toppingId], references: [id])
  price       Int
}

// ===== CÁC BẢNG CỦA MAIN (PAYMENT, PROMOTION) =====

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  idempotencyKey String        @unique
  amount         Int
  method         String
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
}

model Promotion {
  id          String   @id @default(uuid())
  code        String   @unique
  discount    Int
  type        String   @default("PERCENT")
  minOrder    Int      @default(0)
  expiredAt   DateTime?
  active      Boolean  @default(true)
  orders      Order[]
}

model LoyaltyTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int
  reason    String
  orderId   String?
  createdAt DateTime @default(now())
}
