generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== CÁC BẢNG CHUNG =====

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Product {
  id         String      @id @default(uuid())
  name       String
  price      Int
  imageUrl   String?
  category   String      @default("Khác")
  soldCount  Int         @default(0)
  orderItems OrderItem[]
  toppings   Topping[]
  recipes    Recipe[]    // Từ phần của bạn (BOM)
}

model Ingredient {
  id              String   @id @default(uuid())
  name            String
  stock           Float
  reservedQuantity Float   @default(0)
  unit            String   @default("gram")
  recipes         Recipe[]
}

model Recipe {
  id           String     @id @default(uuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  amount       Float
}

model Topping {
  id                String             @id @default(uuid())
  name              String
  price             Int                @default(0)
  stock             Int                @default(50)
  reservedQuantity  Int                @default(0)
  productId         String?
  product           Product?           @relation(fields: [productId], references: [id])
  orderItemToppings OrderItemTopping[]
}

model User {
  id                   String  @id @default(uuid())
  email                String  @unique
  passwordHash         String
  loyaltyPoints        Int     @default(0)
  reservedPoints       Int     @default(0)
  pointsOwed           Int     @default(0)
  role                 String  @default("CUSTOMER") // CUSTOMER, BARISTA, ADMIN
  tokenVersion         Int     @default(0) // Từ phần của main (Auth)
  orders               Order[]
  loyaltyTransactions  LoyaltyTransaction[] // Từ phần của main
}

model Order {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  status      OrderStatus  @default(PENDING)
  total       Int          // Tổng tiền cuối cùng khách phải trả
  shippingFee Int          @default(15000) // Phí ship
  discountAmount Int       @default(0)     // Số tiền được giảm
  createdAt   DateTime     @default(now())
  items       OrderItem[]
  payments    Payment[]
  promotionId String?
  promotion   Promotion?   @relation(fields: [promotionId], references: [id])
  pointsUsed     Int         @default(0) // số điểm dùng cho đơn này
  pointsDiscount Int         @default(0) // tiền giảm từ điểm (pointsUsed x giá trị 1 điểm)
  receiverName    String?
  receiverPhone   String?
  deliveryAddress String?
}

model OrderItem {
  id        String             @id @default(uuid())
  orderId   String
  order     Order              @relation(fields: [orderId], references: [id])
  productId String
  product   Product            @relation(fields: [productId], references: [id])
  size      String
  qty       Int
  unitPrice Int
  lineTotal Int
  toppings  OrderItemTopping[]
}

model OrderItemTopping {
  id          String    @id @default(uuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  toppingId   String
  topping     Topping   @relation(fields: [toppingId], references: [id])
  price       Int
}

// ===== CÁC BẢNG CỦA MAIN (PAYMENT, PROMOTION) =====

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  idempotencyKey String        @unique
  amount         Int
  method         String
  expiresAt      DateTime?
  failedAt       DateTime?
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  @@index([status, expiresAt])
  @@index([orderId, status])
}

model Promotion {
  id          String    @id @default(uuid())
  code        String    @unique
  discount    Int
  type        String    @default("PERCENT")
  minOrder    Int       @default(0)
  startAt     DateTime?  //null = có hiệu lực ngay
  expiredAt   DateTime? //  null = không hết hạn
  usageLimit  Int?      // tổng số lượt dùng toàn hệ thống, null = không giới hạn
  active      Boolean   @default(true) // false = đã xóa mềm / tắt mã
  orders      Order[]
  usages      PromotionUsage[]
}

/// Ghi nhận lượt dùng mã khi đơn lên PAID. Không bị xóa khi đơn bị hủy/hoàn tiền.
model PromotionUsage {
  id          String    @id @default(uuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  userId      String
  orderId     String    @unique
  createdAt   DateTime  @default(now())

  @@unique([userId, promotionId]) // 1 tài khoản chỉ dùng 1 mã 1 lần
  @@index([promotionId])
}


model LoyaltyTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int
  reason    String
  orderId   String?
  createdAt DateTime @default(now())

  @@index([orderId, reason])
}