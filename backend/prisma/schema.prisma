generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== MVP =====

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Product {
  id         String      @id @default(uuid())
  name       String
  price      Int
  imageUrl   String?
  stock      Int         @default(0)
  orderItems OrderItem[]
  toppings   Topping[]
}

model Topping {
  id              String             @id @default(uuid())
  name            String
  price           Int                @default(0)
  productId       String?
  product         Product?           @relation(fields: [productId], references: [id])
  orderItemToppings OrderItemTopping[]
}

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  passwordHash  String
  loyaltyPoints Int     @default(0)
  role          String  @default("CUSTOMER") // CUSTOMER, BARISTA, ADMIN
  orders        Order[]
  loyaltyTransactions LoyaltyTransaction[]
  tokenVersion Int @default(0)
}

model Order {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  status    OrderStatus  @default(PENDING)
  total     Int
  createdAt DateTime     @default(now())
  items     OrderItem[]
  payments  Payment[]
  promotionId String?
  promotion Promotion?   @relation(fields: [promotionId], references: [id])
}

model OrderItem {
  id              String             @id @default(uuid())
  orderId         String
  order           Order              @relation(fields: [orderId], references: [id])
  productId       String
  product         Product            @relation(fields: [productId], references: [id])
  size            String
  qty             Int
  unitPrice       Int                // giá tại thời điểm mua
  lineTotal       Int
  toppings        OrderItemTopping[]
}

model OrderItemTopping {
  id          String    @id @default(uuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  toppingId   String
  topping     Topping   @relation(fields: [toppingId], references: [id])
  price       Int       // giá tại thời điểm mua
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  idempotencyKey String        @unique
  amount         Int
  method         String
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
}

// ===== Task 10 / Mở rộng =====

model Promotion {
  id          String   @id @default(uuid())
  code        String   @unique
  discount    Int      // % hoặc số tiền
  type        String   @default("PERCENT") // PERCENT hoặc FIXED
  minOrder    Int      @default(0)
  expiredAt   DateTime?
  active      Boolean  @default(true)
  orders      Order[]
}

model LoyaltyTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int      // dương = cộng, âm = trừ
  reason    String
  orderId   String?
  createdAt DateTime @default(now())
}